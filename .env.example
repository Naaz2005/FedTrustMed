# FedTrustMed Environment Configuration (Example)
# Research prototype - do not use production credentials here

# PostgreSQL Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=fedtrustmed
DB_USER=postgres
DB_PASSWORD=postgres

# Security Secrets
# JWT_SECRET: Minimum 32 characters
JWT_SECRET=fedtrustmed_research_prototype_jwt_secret_min_32_chars
# MASTER_KEY: Exactly 64 hex characters (32 bytes)
MASTER_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Server Configuration
PORT=3000

# Research Simulation Mode
# Set to 'true' to accept synthetic test identities (TEST-AADHAAR-0001..0006, etc.)
SIMULATION_MODE=true
